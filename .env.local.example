# Firebase web app config — copy to .env.local and fill in
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# RTDB instance URL. For deployed rebuild environments this MUST point at the
# rebuild's OWN RTDB instance (e.g. https://csmidterm-5f652-rebuild.<region>.firebasedatabase.app),
# NOT the legacy default instance — that is how multiplayer stays isolated from `main`.
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Firestore named database for the rebuild's ISOLATED data. Set to "rebuild" in
# Vercel (Preview + Production) so the app reads/writes the dedicated `rebuild`
# database instead of the legacy (default) one. Leave UNSET locally to use the
# emulator's default database. When unset, the app uses the (default) database.
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=

# Optional — enables Firebase Analytics → GA4 in production. Safe to omit
# locally. When unset, every trackEvent call cleanly no-ops.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Local emulator switch (set to "true" to route SDK calls to the Firebase Local Emulator Suite)
NEXT_PUBLIC_USE_EMULATOR=false

# Public site origin (no trailing slash) — used for metadataBase, canonical URLs,
# JSON-LD, the sitemap, and robots.txt. Defaults to the Vercel preview domain when
# unset. Set this to the real production domain in Vercel before cutover.
NEXT_PUBLIC_SITE_URL=

# Server-only — required by the Admin SDK on /api/leaderboard. Paste the entire
# service account JSON as a single-line string. NEVER prefix this with
# NEXT_PUBLIC_ (would expose your private key in the browser bundle). In
# Vercel, add it via Project Settings → Environment Variables (Production +
# Preview only). Locally, run `firebase emulators:start` and the Admin SDK
# auto-detects FIRESTORE_EMULATOR_HOST + FIREBASE_AUTH_EMULATOR_HOST instead.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Server-only — Gemini key for /api/generate-test. REQUIRED in production.
# /api/generate-test reads this via lib/server/geminiKey.ts.
GEMINI_API_KEY=

# DEV FALLBACK ONLY — kept so existing local setups keep working until you
# rotate. lib/server/geminiKey.ts uses this only when GEMINI_API_KEY is
# unset AND we're not in production (NODE_ENV/VERCEL_ENV != production).
# In production this var is IGNORED (with a server-side error log). The
# value would be inlined into the client bundle by Next.js at build time —
# anyone could read it via DevTools. Rotate the key, set GEMINI_API_KEY
# above, and DELETE this var (both locally and in Vercel) before cutover.
# See PROJECT_CONTEXT.md §19 for the full procedure.
NEXT_PUBLIC_GEMINI_API_KEY=

# Sentry — optional error reporting. When unset, the Sentry SDK no-ops
# entirely (instrumentation.ts and sentry.*.config.ts skip init). To enable
# fully (including source-map upload), run `npx @sentry/wizard@latest -i nextjs`
# locally — it will write SENTRY_AUTH_TOKEN and wrap next.config with
# withSentryConfig. The DSN itself is safe to ship in client code.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
