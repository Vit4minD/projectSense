# Copy this file to `.env.local` and fill in your project values.
# `.env.local` is gitignored. Do NOT commit real keys.

# --- Firebase Web SDK (client-side, safe to expose) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# --- Firebase Admin SDK (server-only, KEEP SECRET) ---
# Used by app/api/leaderboard and app/api/stats, plus scripts/migrate-firebase-data.mjs.
# Generate at Firebase Console -> Project Settings -> Service accounts -> Generate new private key.
# Paste the entire JSON contents on a single line (or multi-line in the Vercel UI).
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Gemini AI (testGen page) ---
NEXT_PUBLIC_GEMINI_API_KEY=
