# Firebase web app config — copy to .env.local and fill in
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Optional — enables Firebase Analytics → GA4 in production. Safe to omit
# locally. When unset, every trackEvent call cleanly no-ops.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Local emulator switch (set to "true" to route SDK calls to the Firebase Local Emulator Suite)
NEXT_PUBLIC_USE_EMULATOR=false

# Server-only — required by the Admin SDK on /api/leaderboard. Paste the entire
# service account JSON as a single-line string. NEVER prefix this with
# NEXT_PUBLIC_ (would expose your private key in the browser bundle). In
# Vercel, add it via Project Settings → Environment Variables (Production +
# Preview only). Locally, run `firebase emulators:start` and the Admin SDK
# auto-detects FIRESTORE_EMULATOR_HOST + FIREBASE_AUTH_EMULATOR_HOST instead.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Server-only — Gemini key for /api/generate-test and /api/grade-test. The
# routes fall back to NEXT_PUBLIC_GEMINI_API_KEY if this is unset, but that
# fallback INLINES the key into the client bundle — not safe for prod. Set
# this server-only key in Vercel and rotate the public one before cutover.
GEMINI_API_KEY=
NEXT_PUBLIC_GEMINI_API_KEY=

# Sentry — optional error reporting. When unset, the Sentry SDK no-ops
# entirely (instrumentation.ts and sentry.*.config.ts skip init). To enable
# fully (including source-map upload), run `npx @sentry/wizard@latest -i nextjs`
# locally — it will write SENTRY_AUTH_TOKEN and wrap next.config with
# withSentryConfig. The DSN itself is safe to ship in client code.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
