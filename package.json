{
  "name": "project-sense",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore,database \"vitest run --config vitest.rules.config.ts\"",
    "e2e": "playwright test",
    "emulators": "firebase emulators:start --only auth,firestore,database",
    "e2e:emulators": "firebase emulators:exec --only auth,firestore,database \"playwright test\""
  },
  "dependencies": {
