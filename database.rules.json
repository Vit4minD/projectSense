{
  "rules": {
    "rooms": {
      ".read": "auth != null",
      ".indexOn": ["visibility", "state"],
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid)",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['solved', 'displayName', 'avatarInitials', 'joinedAt'])",
            "solved": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= newData.parent().parent().parent().child('questionCount').val()"
            },
            "displayName": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
            },
            "avatarInitials": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 4"
            },
            "joinedAt": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "finishedAt": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
