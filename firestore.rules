rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A user can read and write only their own profile and subcollections.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /drills/{drillId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /bests/{trickId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Leaderboards are world-readable. Phase 2 will add server-only writes via Cloud Functions.
    match /leaderboards/{trickId}/entries/{uid} {
      allow read: if true;
      allow write: if false;
    }
  }
}
